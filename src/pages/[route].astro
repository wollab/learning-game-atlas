---
import App from '../components/App';
import '../styles.css';
export function getStaticPaths(){return ['catalogue','game','compare','skills','skill','wizard-hat','builder','methodology','sources',...(import.meta.env.DEV?['admin']:[])].map(route=>({params:{route}}));}
const {route}=Astro.params;
---
<!doctype html><html lang="th"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="ค้นหาเกม กติกา และกิจกรรมสร้างการเรียนรู้ผ่าน 12 ทักษะและ Wizard Hat"/><meta property="og:type" content="website"/><meta property="og:title" content="Learning Game Atlas"/><meta property="og:description" content="ทักษะที่ใช่ ให้เป็นเกม — ค้นทักษะ กิจกรรม และกลไกเกมเพื่อออกแบบการเรียนรู้"/><meta property="og:image" content="https://wollab.github.io/learning-game-atlas/assets/brand/atlas-og-v1.png"/><meta property="og:image:alt" content="Learning Game Atlas — ทักษะที่ใช่ ให้เป็นเกม"/><meta name="twitter:card" content="summary_large_image"/><title>Learning Game Atlas</title></head><body><App route={route!} client:load /></body></html>
